# Copia este archivo a .env y completa los valores (.env no se sube a git).
# Contraseña para entrar al dashboard
IB_TRACKER_PASSWORD=
# Llave para firmar la cookie de sesión. Genera una con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
IB_TRACKER_SECRET_KEY=
# Minutos de inactividad antes de pedir la contraseña otra vez (por defecto 30)
IB_TRACKER_SESSION_MINUTES=30
